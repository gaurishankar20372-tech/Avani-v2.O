{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and Avani personal configuration",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Authentication User ID"
        },
        "name": {
          "type": "string",
          "description": "Display name or nickname for the user"
        },
        "language": {
          "type": "string",
          "description": "Preferred language (hi, en, auto)"
        },
        "createdAt": {
          "type": "number",
          "description": "Profile creation timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Profile last update timestamp"
        }
      },
      "required": ["userId", "createdAt"]
    },
    "Memory": {
      "title": "Memory",
      "description": "Permanent long-term memory entry remembered by Avani",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Memory unique identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "category": {
          "type": "string",
          "description": "Category of memory: fact, preference, task, or note"
        },
        "key": {
          "type": "string",
          "description": "Short summary or key of the memory"
        },
        "content": {
          "type": "string",
          "description": "The exact fact or note Avani learned and remembers"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when this memory was formed"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp when this memory was updated"
        }
      },
      "required": ["id", "userId", "content", "createdAt"]
    },
    "ChatMessageRecord": {
      "title": "ChatMessageRecord",
      "description": "Persistent conversation message turn between user and Avani",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message unique identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "sender": {
          "type": "string",
          "description": "Sender identifier: user or avani"
        },
        "text": {
          "type": "string",
          "description": "Message content"
        },
        "timestamp": {
          "type": "number",
          "description": "Message unix timestamp"
        },
        "fileTitle": {
          "type": "string",
          "description": "Optional title of generated file"
        },
        "fileName": {
          "type": "string",
          "description": "Optional name of generated file"
        },
        "fileContent": {
          "type": "string",
          "description": "Optional code or document content"
        }
      },
      "required": ["id", "userId", "sender", "text", "timestamp"]
    },
    "SavedFileRecord": {
      "title": "SavedFileRecord",
      "description": "Permanent record of code or document generated by Avani",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique file identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "description": "Document or script title"
        },
        "fileName": {
          "type": "string",
          "description": "File name with extension"
        },
        "content": {
          "type": "string",
          "description": "Source code or document content"
        },
        "fileType": {
          "type": "string",
          "description": "File type: code, document, letter, etc."
        },
        "language": {
          "type": "string",
          "description": "Language or format"
        },
        "exportFormat": {
          "type": "string",
          "description": "Preferred export format"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "title", "fileName", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with personal assistant preferences"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "Memory",
      "description": "Avani persistent long-term memory facts and notes for this user"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": "ChatMessageRecord",
      "description": "Persistent conversation history between the user and Avani"
    },
    "/users/{userId}/savedFiles/{fileId}": {
      "schema": "SavedFileRecord",
      "description": "Library of files and scripts generated for the user"
    }
  }
}
